# Server-only. Never prefix credentials with VITE_.
BACKEND_URL=http://127.0.0.1:8000
# By default the local proxy reads DJANGO_API_TOKEN from ../backend/.env.
# Set this only when using a separate backend configuration.
DJANGO_API_TOKEN=

# Supabase Auth en el navegador (valores públicos; RLS protege los datos).
# Si se dejan vacíos, se leen SUPABASE_URL y SUPABASE_PUBLISHABLE_KEY de ../backend/.env.
# Nunca pongas aquí SUPABASE_PASSWORD ni claves service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
