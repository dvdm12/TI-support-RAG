# Copia este archivo a .env y completa los valores reales.
# .env NUNCA debe subirse al repositorio (ya está en .gitignore).

# ── Supabase ──────────────────────────────────────────────────────────────────
# URL del proyecto (ej. https://xxxx.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anon/publishable (empieza con sb_publishable_ o eyJ...)
# En el panel de Supabase: Settings → API → Project API Keys → anon/public
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Backend Django ────────────────────────────────────────────────────────────
# URL base del servidor backend (sin barra final)
BACKEND_URL=http://127.0.0.1:8000

# Token Bearer del backend (definido en backend/.env como DJANGO_API_TOKEN)
BACKEND_API_TOKEN=cambia-esto-por-el-token-real

# ── Gradio (opcionales) ───────────────────────────────────────────────────────
# Interfaz de red en la que escucha Gradio (0.0.0.0 para Docker, 127.0.0.1 local)
GRADIO_SERVER_NAME=0.0.0.0
# Puerto local. En Render no se define: Render inyecta PORT y tiene prioridad.
GRADIO_SERVER_PORT=7860
